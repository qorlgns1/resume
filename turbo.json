{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_OUTPUT"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CONTENT_SOURCE",
        "CONTENT_API_URL",
        "CONTENT_API_TIMEOUT_MS",
        "PUBLIC_SITE_URL",
        "PORT",
        "DATABASE_PATH",
        "AUTH_SECRET",
        "ADMIN_URL"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CONTENT_SOURCE",
        "CONTENT_API_URL",
        "CONTENT_API_TIMEOUT_MS",
        "PUBLIC_SITE_URL",
        "PORT",
        "HOSTNAME",
        "DATABASE_PATH",
        "AUTH_SECRET",
        "ADMIN_URL"
      ]
    }
  }
}
