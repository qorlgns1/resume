# Docker Compose용 환경 변수. 복사해서 저장소 루트의 .env로 사용한다 (커밋 금지).

# 어드민 세션 서명 키 (32자 이상). 만들기: openssl rand -base64 32
AUTH_SECRET=

# 호스트에 열 포트 (다른 서비스와 겹치면 바꾼다)
WEB_PORT=3000
ADMIN_PORT=3001

# 공개 사이트 콘텐츠 출처: api(어드민의 게시본) | sample
CONTENT_SOURCE=api

# 브라우저가 여는 공개 사이트 주소 (선택). 비우면 요청 헤더(Host, X-Forwarded-Proto)로 만든다. 운영에서는 실제 도메인 권장
SITE_URL=

# 방문 분석 (선택). 비워 두면 추적 스크립트를 싣지 않는다. README의 "방문 분석" 참고
POSTHOG_KEY=
# PostHog 주소. 미국 클라우드가 기본값, 유럽은 https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
