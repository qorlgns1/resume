{
  "name": "@resume/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "CSS 변수 기반 디자인 토큰과 Tailwind 테마 매핑",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./theme.css": "./src/theme.css",
    "./font.css": "./src/font.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "@resume/config": "workspace:*",
    "typescript": "6.0.3"
  }
}
