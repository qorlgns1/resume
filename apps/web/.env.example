# 공개 사이트 환경 변수. 복사해서 .env.local로 사용한다. 모든 값은 서버에서만 읽는다(NEXT_PUBLIC_ 없음).

# 콘텐츠 출처: sample | api
#  - sample: 저장소에 포함된 샘플 데이터로 렌더링 (어드민 없이 실행·빌드 가능)
#  - api: 어드민 앱의 공개 콘텐츠 API에서 읽음. 실패하면 샘플로 대체하지 않고 오류 화면을 보여준다.
CONTENT_SOURCE=sample

# api 모드에서 서버가 호출할 어드민 주소 (브라우저가 아닌 web 서버가 접근하는 주소)
#  - 로컬: http://localhost:3201
#  - Docker Compose: http://admin:3001 (컨테이너 내부 네트워크 이름)
CONTENT_API_URL=http://localhost:3201

# api 호출 제한 시간(ms). 비우면 5000
CONTENT_API_TIMEOUT_MS=5000
