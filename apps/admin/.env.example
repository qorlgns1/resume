# 어드민 환경 변수. 복사해서 .env.local로 사용한다. 비밀 값은 커밋하지 않는다.

# 브라우저가 접속하는 어드민 주소. 로그인 요청의 출처(Origin) 검사에 쓴다. 운영 환경에서는 필수.
ADMIN_URL=http://localhost:3001

# 세션 서명 키 (32자 이상). 운영 환경에서는 필수. 만들기: openssl rand -base64 32
# 개발 환경에서 비워 두면 안전하지 않은 개발용 기본값을 쓴다.
AUTH_SECRET=

# SQLite 파일 경로. 기본값 ./data/resume.db (Docker: /data/resume.db)
DATABASE_PATH=./data/resume.db

# 브라우저에서 여는 공개 사이트 주소. 상단의 "공개 사이트" 링크에 사용한다.
# Docker Compose에서도 컨테이너 이름(web)이 아니라 브라우저가 접근하는 주소(localhost)를 쓴다.
PUBLIC_SITE_URL=http://localhost:3000
